      <column caption='MoM Revenue Growth' datatype='real' default-format='p0.00%' name='[Calculation_0257887582801927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(SUM([Calculation_0257887555051522]),-1)) &#13;&#10;THEN &#13;&#10;    0&#13;&#10;ELSE (SUM([Calculation_0257887555051522]) - LOOKUP(SUM([Calculation_0257887555051522]),-1)) &#13;&#10;/ ABS(LOOKUP(SUM([Calculation_0257887555051522]),-1))&#13;&#10;END'>
