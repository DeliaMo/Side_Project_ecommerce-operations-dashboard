    <worksheet name='Monthly Revenue Growth'>
      <layout-options>
        <title>
          <formatted-text>
            <run>月營收增長率</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='clean_sales' name='federated.0gyi4vs06kgob81c8xo0g1m8aoff' />
          </datasources>
          <datasource-dependencies datasource='federated.0gyi4vs06kgob81c8xo0g1m8aoff'>
            <column caption='Revenue' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0257887555051522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Quantity] * [UnitPrice],2)' />
            </column>
            <column caption='Sales Month' datatype='datetime' name='[Calculation_0257887572770822]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[InvoiceDate])' />
            </column>
            <column caption='MoM Revenue Growth' datatype='real' default-format='p0.00%' name='[Calculation_0257887582801927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(LOOKUP(SUM([Calculation_0257887555051522]),-1)) &#13;&#10;THEN &#13;&#10;    0&#13;&#10;ELSE (SUM([Calculation_0257887555051522]) - LOOKUP(SUM([Calculation_0257887555051522]),-1)) &#13;&#10;/ ABS(LOOKUP(SUM([Calculation_0257887555051522]),-1))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM Growth Status' datatype='string' name='[Calculation_0257887586480137]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0257887582801927] &gt;0 THEN &quot;Growth&quot;&#13;&#10;ELSEIF [Calculation_0257887582801927] &lt; 0 THEN &quot;Decline&quot; &#13;&#10;ELSE &#13;&#10;    &quot;no change&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Invoice Date' datatype='datetime' name='[InvoiceDate]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column caption='Unit Price' datatype='real' name='[UnitPrice]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0257887572770822]' derivation='Month-Trunc' name='[tmn:Calculation_0257887572770822:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0257887582801927]' derivation='User' name='[usr:Calculation_0257887582801927:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
            <column-instance column='[Calculation_0257887586480137]' derivation='User' name='[usr:Calculation_0257887586480137:nk:1]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.0gyi4vs06kgob81c8xo0g1m8aoff].[Calculation_0257887582801927]' ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='label'>
