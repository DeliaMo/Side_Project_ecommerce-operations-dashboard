        </calculation>
      </column>
      <column caption='MoM Growth Status' datatype='string' name='[Calculation_0257887586480137]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0257887582801927] &gt;0 THEN &quot;Growth&quot;&#13;&#10;ELSEIF [Calculation_0257887582801927] &lt; 0 THEN &quot;Decline&quot; &#13;&#10;ELSE &#13;&#10;    &quot;no change&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM Customer Growth' datatype='real' name='[Calculation_0257887884345354]' role='measure' type='quantitative'>
